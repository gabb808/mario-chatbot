    ns1:eurog "Wii: 8/10" ;
    ns1:footer "The game's director, designer, and composer pictured together in 2015: Takashi Tezuka, Shigeru Miyamoto, and Koji Kondo." ;
    ns1:genre dbr:Platformer ;
    ns1:gspot "Wii: 6.5/10" ;
    ns1:ign "3" ;
    ns1:image "Kōji Kondō 2015 .jpg",
        "Shigeru Miyamoto 2015 .jpg",
        "Takashi Tezuka 2015 .jpg" ;
    ns1:modes dbr:Single-player_video_game ;
    ns1:nlife "Wii U: 8/10" ;
    ns1:platforms dbr:Famicom_Disk_System ;
    ns1:producer "Shigeru Miyamoto" ;
    ns1:publisher dbr:Nintendo ;
    ns1:quote "As I continued to play, I found that Super Mario Bros.2 asked me again and again to take a leap of faith, and each of those leaps resulted in my immediate death. This was not a fun game to play. It was punishmentundeserved punishment. I put down my controller, astonished that Mr. Miyamoto had chosen to design such a painful game." ;
    ns1:released "--06-03" ;
    ns1:rev1score "FDS: 3/5, 2/5, 2/5" ;
