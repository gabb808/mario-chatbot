    ns1:developer "Intelligent Systems" ;
    ns1:director "Masahiko Nagaya" ;
    ns1:egm "3" ;
    ns1:fam "36" ;
    ns1:genre dbr:Action-adventure_game,
        dbr:Role-playing_video_game ;
