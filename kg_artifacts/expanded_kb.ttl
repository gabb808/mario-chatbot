        dbr:Shigeru_Miyamoto__PersonFunction__1 ;
    dbo:thumbnail <http://commons.wikimedia.org/wiki/Special:FilePath/Shigeru_Miyamoto_20150610_(cropped).jpg?width=300> ;
    ns1:align "right" ;
    ns1:almaMater dbr:Kanazawa_College_of_Art ;
    ns1:awards dbr:BAFTA_Fellowship,
        dbr:Person_of_Cultural_Merit,
        "AIAS Hall of Fame Award" ;
    ns1:birthDate "1952-11-16" ;
    ns1:birthPlace "Sonobe, Kyoto, Japan" ;
    ns1:caption "Miyamoto in 2015" ;
    ns1:children "2" ;
    ns1:date "2011-07-15" ;
    ns1:employer dbr:Nintendo ;
    ns1:name "Shigeru Miyamoto" ;
    ns1:nativeName "宮本 茂" ;
    ns1:nativeNameLang "ja" ;
    ns1:notableWorks "",
        "Donkey Kong",
        "F-Zero",
        "Mario",
        "Nintendogs",
        "Pikmin",
        "Star Fox",
        "The Legend of Zelda" ;
    ns1:occupation "",
        "Game designer",
        "game director",
        "game producer" ;
    ns1:quote "[Miyamoto] approaches the games playfully, which seems kind of obvious, but most people don't. And he approaches things from the players' point of view, which is part of his magic." ;
    ns1:quotetext "People have paid me a lot of lip service, calling me a genius story teller or a talented animator, and have gone so far as to suggest that I try my hand at movies, since my style of game design is, in their words, quite similar to making movies. But I feel that I am not a movie maker, but rather that my strength lies in my pioneering spirit to make use of technology to create the best, interactive commodities possible, and use that interactivity to give users a game they can enjoy and play comfortably." ;
    ns1:signature "Shigeru Miyamoto's signature.svg" ;
    ns1:source dbr:The_New_Yorker,
        dbr:Will_Wright_\(game_designer\),
        "Shigeru Miyamoto" ;
    ns1:spouse "Yasuko Miyamoto" ;
    ns1:text "I feel that I have been very lucky to be a game designer since the dawn of the industry. I am not an engineer, but I have had the opportunities to learn the principles of game [design] from scratch, over a long period of time. And because I am so pioneering and trying to keep at the forefront, I have grown accustomed to first creating the very tools necessary for game creation." ;
    ns1:title "Video profile of Shigeru Miyamoto" ;
    ns1:url <https://web.archive.org/web/20110715005452/http:/www.onnetworks.com/videos/play-value/shigeru-miyamoto> ;
